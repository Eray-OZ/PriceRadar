@{
    ViewData["Title"] = "Overview";
}

<section class="simple-home">
    <div class="eyebrow"><span class="eyebrow-dot"></span> Marketplace price tracker</div>
    <h1>Track prices. Buy with confidence.</h1>
    <p>Save a product URL, keep its current price in view, and receive an alert when it changes.</p>

    <div class="simple-home-actions">
        <a class="button button-primary" asp-controller="Products" asp-action="Index">View tracked products</a>
        <a class="button button-ghost" asp-controller="Products" asp-action="Add">Add a product</a>
    </div>
</section>
