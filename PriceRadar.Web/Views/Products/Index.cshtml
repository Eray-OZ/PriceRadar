@model List<PriceRadar.Data.Entities.TrackedProduct>

@{
    ViewData["Title"] = "Takip Edilen Ürünler";
}

<section class="tracker-page">
    <div class="page-heading tracker-heading">
        <div>
            <p class="eyebrow">PRICE MONITOR / LIVE WATCHLIST</p>
            <h1>Takip Edilen Ürünler</h1>
            <p class="page-subtitle">Piyasa verileri canlı olarak izleniyor.</p>
        </div>
        <div class="item-counter" aria-label="Takip edilen ürün sayısı">
            <strong>@Model.Count</strong>
            <span>ÜRÜN</span>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <section class="empty-state brutal-panel">
            <span class="empty-mark" aria-hidden="true">+</span>
            <p class="eyebrow">WATCHLIST EMPTY</p>
            <h2>Henüz ürün eklenmedi.</h2>
            <p>Bir pazaryeri seçip ürün bağlantısını ekleyerek fiyat takibini başlat.</p>
            <a class="brutal-button brutal-button-primary" asp-controller="Products" asp-action="Add">
                <span aria-hidden="true">+</span> YENİ ÜRÜN EKLE
            </a>
        </section>
    }
    else
    {
        <section class="product-table-shell brutal-panel" aria-label="Takip edilen ürünler tablosu">
            <div class="table-scroll">
                <table class="products-table">
                    <colgroup>
                        <col class="col-marketplace" />
                        <col class="col-product" />
                        <col class="col-seller" />
                        <col class="col-price" />
                        <col class="col-check" />
                        <col class="col-status" />
                        <col class="col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>PAZARYERİ</th>
                            <th>ÜRÜN ADI</th>
                            <th>SATICI</th>
                            <th class="align-right">GÜNCEL FİYAT</th>
                            <th>SON KONTROL</th>
                            <th>DURUM</th>
                            <th class="align-center">İŞLEM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            var marketplaceClass = string.Equals(product.Marketplace, "Trendyol", StringComparison.OrdinalIgnoreCase)
                                ? "marketplace-trendyol"
                                : "marketplace-hepsiburada";
                            var lastChecked = product.LastCheckedAt.HasValue
                                ? product.LastCheckedAt.Value.ToLocalTime().ToString("dd MMM HH:mm")
                                : "—";

                            <tr class="@(product.IsActive ? "is-active" : "is-paused")">
                                <td data-label="Pazaryeri">
                                    <span class="marketplace-badge @marketplaceClass">@product.Marketplace</span>
                                </td>
                                <td data-label="Ürün adı">
                                    <div class="product-info">
                                        <strong class="product-name" title="@product.ProductName">@product.ProductName</strong>
                                        <a class="product-url" href="@product.Url" target="_blank" rel="noopener noreferrer">ÜRÜNÜ AÇ <span aria-hidden="true">↗</span></a>
                                    </div>
                                </td>
                                <td class="seller-cell" data-label="Satıcı">@(string.IsNullOrWhiteSpace(product.SellerName) ? "Bilinmiyor" : product.SellerName)</td>
                                <td class="price-cell" data-label="Güncel fiyat">
                                    ₺@product.CurrentPrice.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
                                </td>
                                <td class="checked-cell" data-label="Son kontrol">@lastChecked</td>
                                <td data-label="Durum">
                                    @if (product.IsActive)
                                    {
                                        <span class="status-badge status-active"><span class="status-dot"></span> AKTİF</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-paused"><span class="status-dot"></span> DURAKLATILDI</span>
                                    }
                                </td>
                                <td class="actions-cell" data-label="İşlem">
                                    <a class="icon-button" href="@product.Url" target="_blank" rel="noopener noreferrer" aria-label="@product.ProductName ürününü aç">↗</a>
                                    @if (product.IsActive)
                                    {
                                        <form asp-controller="Products" asp-action="DisableTracking" method="post" class="inline-form">
                                            <input type="hidden" name="id" value="@product.Id" />
                                            <button class="icon-button" type="submit" aria-label="@product.ProductName takibini duraklat">Ⅱ</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="icon-button icon-button-disabled" aria-hidden="true">▶</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
