@model PriceRadar.Web.Models.AddProductViewModel

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    var selectedMarketplace = Model?.Marketplace ?? "Hepsiburada";
}

<section class="add-page">
    <a class="back-link" asp-controller="Products" asp-action="Index">← TAKİP EDİLENLERE DÖN</a>

    <div class="add-card brutal-panel">
        <header class="add-card-header">
            <div>
                <p class="eyebrow">PRICE MONITOR / NEW TARGET</p>
                <h1>Yeni Ürün Ekle</h1>
            </div>
            <span class="add-card-symbol" aria-hidden="true">◎</span>
        </header>

        <div class="add-card-body">
            <p class="add-intro">Takip etmek istediğin ürünün pazaryerini ve doğrudan ürün bağlantısını gir. Ürün adı ve güncel fiyat, arka plandaki ilk kontrolden sonra otomatik olarak alınır.</p>

            <form asp-controller="Products" asp-action="Add" method="post" class="product-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <fieldset class="field-group">
                    <legend>PAZARYERİ SEÇ</legend>
                    <div class="marketplace-options">
                        <label class="marketplace-option">
                            <input asp-for="Marketplace" type="radio" value="Hepsiburada" id="marketplace-hepsiburada" checked="@(selectedMarketplace == "Hepsiburada" ? "checked" : null)" />
                            <span class="marketplace-option-box"></span>
                            <span>Hepsiburada</span>
                        </label>
                        <label class="marketplace-option">
                            <input asp-for="Marketplace" type="radio" value="Trendyol" id="marketplace-trendyol" checked="@(selectedMarketplace == "Trendyol" ? "checked" : null)" />
                            <span class="marketplace-option-box"></span>
                            <span>Trendyol</span>
                        </label>
                    </div>
                    <span asp-validation-for="Marketplace" class="validation-message"></span>
                </fieldset>

                <div class="field-group">
                    <label asp-for="Url">ÜRÜN URL'Sİ</label>
                    <input asp-for="Url" class="text-input" type="url" placeholder="https://..." autocomplete="url" />
                    <span class="field-hint">Sadece desteklenen pazaryerlerinden doğrudan bir ürün bağlantısı kullan.</span>
                    <span asp-validation-for="Url" class="validation-message"></span>
                </div>

                <button class="brutal-button brutal-button-primary submit-button" type="submit">
                    <span aria-hidden="true">+</span> ÜRÜNÜ EKLE
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
