<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PriceRadar</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Montserrat:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PriceRadar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" asp-area="" asp-controller="Products" asp-action="Index" aria-label="PriceRadar takip edilen ürünler">
                    <span class="brand-mark" aria-hidden="true">◎</span>
                    <span class="brand-name">PRICERADAR</span>
                </a>

                <nav class="main-nav" aria-label="Ana navigasyon">
                    <a class="nav-link nav-link-active" asp-area="" asp-controller="Products" asp-action="Index">TAKİP EDİLENLER</a>
                </nav>

                <div class="header-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="signed-in-user">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                            <button class="auth-button" type="submit">LOG OUT</button>
                        </form>
                    }
                    else
                    {
                        <a class="auth-link" asp-controller="Account" asp-action="Login">LOG IN</a>
                        <a class="auth-button" asp-controller="Account" asp-action="Register">CREATE ACCOUNT</a>
                    }

                    <a class="header-add" asp-area="" asp-controller="Products" asp-action="Add">
                        <span aria-hidden="true">+</span>
                        YENİ ÜRÜN EKLE
                    </a>
                </div>
            </div>
        </header>

        <main class="page-shell" role="main">
            @RenderBody()
        </main>

        <nav class="mobile-nav" aria-label="Mobil navigasyon">
            <a class="mobile-nav-link mobile-nav-link-active" asp-area="" asp-controller="Products" asp-action="Index">
                <span aria-hidden="true">▥</span>
                <small>TAKİP</small>
            </a>
            <a class="mobile-nav-link" asp-area="" asp-controller="Products" asp-action="Add">
                <span aria-hidden="true">＋</span>
                <small>YENİ ÜRÜN</small>
            </a>
        </nav>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
