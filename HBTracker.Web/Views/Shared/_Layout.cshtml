<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HBTracker</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HBTracker.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" asp-area="" asp-controller="Products" asp-action="Index">
                    <span class="brand-mark">HB</span>
                    <span class="brand-copy">
                        <strong>HBTracker</strong>
                        <small>Price intelligence</small>
                    </span>
                </a>

                <nav class="main-nav" aria-label="Main navigation">
                    <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Tracked products</a>
                </nav>

                <a class="button button-small button-primary" asp-area="" asp-controller="Products" asp-action="Add">
                    <span class="button-plus">+</span>
                    Add product
                </a>
            </div>
        </header>

        <main class="page-shell" role="main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <div>
                <span class="footer-brand">HBTracker</span>
                <span class="footer-divider">·</span>
                Built for better timing
            </div>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
